# ─── Database ──────────────────────────────────────────────────────────────

# Runtime connection — used by the app and worker for all queries
DATABASE_URL="postgresql://user:password@host:5432/db"

# Connection pooler URL (optional but recommended for production).
# When set, pg.Pool will target this URL instead of DATABASE_URL, routing
# all runtime queries through your pooler to avoid direct connection exhaustion.
#
# Neon pooled endpoint:
#   DATABASE_POOL_URL="postgres://<user>:<pass>@<ep>-pooler.neon.tech/neondb?pgbouncer=true&sslmode=require"
# Supabase Transaction Pooler (port 6543):
#   DATABASE_POOL_URL="postgresql://<user>:<pass>@<project>.pooler.supabase.com:6543/postgres"
# PgBouncer (self-hosted):
#   DATABASE_POOL_URL="postgresql://user:password@localhost:5432/db?pgbouncer=true"
DATABASE_POOL_URL=""

# Direct connection — Prisma migrations only (db:push, db:migrate).
# Must bypass any pooler (PgBouncer/Supavisor do not support DDL statements).
DIRECT_URL="postgresql://user:password@host:5432/db"

# ─── Auth ──────────────────────────────────────────────────────────────────

# Base URL for the auth server (e.g. http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# Cryptographic secret for session cookies (min 32 characters)
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-chars"

# Allowed CORS origin
CORS_ORIGIN="http://localhost:3000"

# ─── Application URLs ──────────────────────────────────────────────────────

# Public-facing app URL (used server- and client-side)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public-facing worker URL (for client-side WebSockets & direct probes)
NEXT_PUBLIC_WORKER_URL="http://localhost:8787"

# Server-side worker URL (used by Next.js server actions to trigger check-now / proxy)
PULSEGUARD_WORKER_URL="http://localhost:8787"

# Expo mobile app server URL
EXPO_PUBLIC_SERVER_URL="http://localhost:3000"

# ─── Security & Analytics ──────────────────────────────────────────────────

# Analytics hashing salt
ANALYTICS_SALT="pulseguard-analytics-salt"

# Comma-separated list of admin email addresses for privileged operations
ADMIN_EMAILS=""

# ─── Redis (optional — resilience fallback) ────────────────────────────────

# Upstash Redis REST URL for connection pooling fallback
UPSTASH_REDIS_REST_URL=""

# Upstash Redis authentication token
UPSTASH_REDIS_REST_TOKEN=""

# ─── Email (optional) ──────────────────────────────────────────────────────

# Resend API key for transactional email delivery
RESEND_API_KEY=""

# ─── AI (OpenRouter / Ollama / OpenAI) ──────────────────────────────────────

# Provider strategy: "auto" | "openrouter" | "ollama" | "openai" (default: "auto")
AI_PROVIDER="auto"

# OpenRouter (Production default — supports Claude 3.5, Llama 3.3, DeepSeek, etc.)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Ollama (Local testing & self-hosted development)
# Standard local URL: http://localhost:11434/v1
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.2"

# OpenAI API key (legacy fallback)
OPENAI_API_KEY=""

# ─── Helicone (LLM Observability, Semantic Caching & Proxy) ──────────────────

# Helicone API Key (logs, caches, and attributes usage per workspace & feature)
HELICONE_API_KEY=""
# Helicone Base Path / Proxy Gateway URL (default: https://oai.helicone.ai/v1)
HELICONE_BASE_PATH="https://oai.helicone.ai/v1"
# Semantic caching flag ("true" | "false")
HELICONE_CACHE_ENABLED="true"

# ─── Pinecone (Vector Database & Semantic Incident RAG) ─────────────────────

# Pinecone API Key (retrieved from Pinecone Console)
PINECONE_API_KEY=""
# Pinecone Index Name (defaults to "pulseguard-incidents", 1536 dims, cosine metric)
PINECONE_INDEX_NAME="pulseguard-incidents"

# ─── Slack Integration (optional) ──────────────────────────────────────────

SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""
SLACK_REDIRECT_URI="http://localhost:3000/api/integrations/slack/callback"

# ─── Discord Integration (optional) ────────────────────────────────────────

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/integrations/discord/callback"

# ─── Google OAuth Integration (optional) ───────────────────────────────────

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Cloudflare Worker — Sharding (optional) ───────────────────────────────

# Horizontal scaling: set to 0-based shard index
SHARD_ID=0

# Total number of shards
TOTAL_SHARDS=1

# ─── Infrastructure Deployment (optional) ──────────────────────────────────

# Password for Alchemy-based Cloudflare deployments
ALCHEMY_PASSWORD=""

# ─── Vercel Integration (optional) ─────────────────────────────────────────

# Vercel OAuth App Integration
VERCEL_CLIENT_ID=""
VERCEL_CLIENT_SECRET=""
VERCEL_REDIRECT_URI="http://localhost:3000/api/integrations/vercel/callback"

# Vercel Domain Management API
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# ─── Stripe Billing (optional) ─────────────────────────────────────────────

# Stripe API keys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs for Netrunner (Sleep Plan) and Construct (Enterprise)
STRIPE_NETRUNNER_MONTHLY_PRICE_ID="price_netrunner_monthly"
STRIPE_NETRUNNER_ANNUAL_PRICE_ID="price_netrunner_annual"
STRIPE_CONSTRUCT_MONTHLY_PRICE_ID="price_construct_monthly"
STRIPE_CONSTRUCT_ANNUAL_PRICE_ID="price_construct_annual"

# ─── Runtime & Healthchecks ───────────────────────────────────────────────────

NODE_ENV="development"

# External dead-man's switch URL (e.g. Healthchecks.io, Dead Man's Snitch, Better Stack)
DEADMAN_SNITCH_URL=""
HEALTHCHECK_PING_URL=""

# ─── Uploadthing ───────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=""

# Comma-separated allowed origins for Next.js dev server cross-origin requests
ALLOWED_DEV_ORIGINS=""

