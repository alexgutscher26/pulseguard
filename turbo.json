{
  "$schema": "https://v2-9-14.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CORS_ORIGIN",
    "PUBLIC_INSTAGRES_CLAIM_URL",
    "UPLOADTHING_TOKEN",
    "RESEND_API_KEY",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_REDIRECT_URI",
    "SLACK_SIGNING_SECRET",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "DISCORD_REDIRECT_URI",
    "OPENAI_API_KEY",
    "HELICONE_API_KEY",
    "HELICONE_BASE_PATH",
    "HELICONE_CACHE_ENABLED",
    "PINECONE_API_KEY",
    "PINECONE_INDEX_NAME",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_INSTAGRES_CLAIM_URL",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "VERCEL_CLIENT_ID",
    "VERCEL_CLIENT_SECRET",
    "VERCEL_REDIRECT_URI"
  ],
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@pulseguard/db#db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "check": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },
    "size-limit": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "depcheck": {
      "outputs": []
    },
    "publint": {
      "outputs": []
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema/**", "prisma/schema.prisma", "package.json"],
      "outputs": ["src/generated/**"]
    },
    "deploy": {
      "dependsOn": ["build", "lint", "check-types"],
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  }
}
