{
  "name": "@steadystack/probe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js --target node",
    "start": "node dist/index.js",
    "docker:build": "docker build -f Dockerfile -t steadystack-probe ../..",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@steadystack/core": "workspace:*",
    "@steadystack/env": "workspace:*",
    "@steadystack/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
